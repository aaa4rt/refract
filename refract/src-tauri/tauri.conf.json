{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Refract",
  "version": "0.1.0",
  "identifier": "io.github.aaa4rt.refract",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Lightweight Spotify remote with a liquid glass theme",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
